# ── Movenetics Lead Search ────────────────────────────────────────────────
# Everything lives in one folder, which is the document root of
# lead.moveneticsdigital.com. That means app/, var/ and .env sit INSIDE the
# web root, so the deny rules below are load-bearing, not decoration.
# If this file is ever lost or mod_rewrite is off, those paths become public.

# Directory listing off. Without this, / shows an index of every file here.
Options -Indexes

DirectoryIndex login.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. HTTPS first — session cookies are issued Secure over TLS.
  #    Comment out only if the certificate is not issued yet.
  #
  #    308, not 301: a 301 makes browsers re-issue the request as GET and throw
  #    the body away. Every login POST arriving over HTTP would turn into
  #    GET /api/auth/login and fail with "does not accept GET requests".
  #    308 preserves both the method and the body.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]

  # 2. Application internals are never served, at any depth.
  RewriteRule ^(app|var|vendor|tests)(/|$) - [F,L]

  # 3. Everything under /api/ goes to the PHP front controller.
  RewriteRule ^api/ index.php [QSA,L]
</IfModule>

# ── Belt and braces: deny by filename too, so a missing mod_rewrite does not
#    silently expose the config or the source.
<FilesMatch "^\.env|\.(ini|md|log|sql|json|lock)$">
  Require all denied
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# .user.ini is read by PHP itself and must never be downloadable.
<Files ".user.ini">
  Require all denied
</Files>

# setup.php locks itself once an admin account exists. Delete it after the
# first run; uncommenting this blocks it outright in the meantime.
# <Files "setup.php">
#   Require all denied
# </Files>

# ── Security headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Google Fonts is the only external origin these pages use. 'unsafe-inline'
  # covers style attributes only — scripts are strictly same-origin files.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-uez6fAitd7gpKyFo0GiN9ITeaKzUASDNLNqC4Ply9ow='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  <FilesMatch "\.(html|php)$">
    Header always set Cache-Control "no-store, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js|png|svg|woff2)$">
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
