# ─── OPTIONAL ───
#
# The live settings are now built into app/config.php, so the app runs with no
# .env file at all. This file is only a template for overriding them — useful
# for a staging copy, or a second install pointing at a different database.
#
# Precedence: real environment variable  >  .env  >  app/config.php built-ins.
# Any key you leave out here falls back to the built-in value.
#
# To use it: copy to .env in the site root (the folder holding index.php),
# then  chmod 600 .env
#
# Do NOT put real credentials in THIS file — it is committed to git.

APP_ENV=production
APP_URL=https://lead.moveneticsdigital.com

# ─── MariaDB ───
DB_HOST=localhost
DB_PORT=3306
DB_NAME=movenetics_lead
DB_USER=movenetics_moutasim
# Wrap in SINGLE quotes. Passwords containing $, [, ^ or # are otherwise
# mangled by the parser.
DB_PASSWORD='replace-me'

# Pre-existing leads table, registered as a protected dataset on migrate.
LEADS_TABLE=leads

# ─── Sessions ───
# Generate with:  php -r "echo bin2hex(random_bytes(48));"
# Changing this signs everyone out.
SESSION_SECRET=replace-me-with-96-hex-chars
SESSION_HOURS=12

# ─── n8n ───
# Called server-side only. These never reach the browser.
N8N_WEBHOOK_URL=https://n8n.moveneticsdigital.com/webhook/lead-search-v2
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=120

# ─── Clutch pipeline (source of the `clutch` table) ───
CLUTCH_DB_HOST=localhost
CLUTCH_DB_PORT=3306
CLUTCH_DB_NAME=movenetics_testing
CLUTCH_DB_USER=movenetics_clutch
CLUTCH_DB_PASSWORD='replace-me'
CLUTCH_SOURCE_TABLE=leads

# Where to read the Clutch app log from. Use ONE of:
#  a) same server: absolute path to its log file
CLUTCH_LOG_FILE=/home/movenetics/public_html/clutch.moveneticsdigital.com/logs/app.log
#  b) over HTTP: the Clutch app's URL and its INGEST_API_KEY
CLUTCH_APP_URL=
CLUTCH_API_KEY=
