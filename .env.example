# ─── Copy to .env on the server and fill in. Never commit .env. ───
# On cPanel:  chmod 600 .env   and keep it OUTSIDE public_html.

APP_ENV=production
# Full public URL of the site. Used for cookie scope and origin checks.
APP_URL=https://leads.moveneticsdigital.com

# ─── MariaDB ───
# On cPanel the database is on the same box, so localhost is correct.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=movenetics_lead
DB_USER=movenetics_moutasim
# IMPORTANT: wrap the password in SINGLE quotes. Passwords containing $, [, ^ or #
# are otherwise mangled by the .env parser.
DB_PASSWORD='@Iv+rUv_^$EeSm[Q'

# Name of the existing 248k-record leads table. Registered as a protected dataset
# on migrate so it can be searched but never dropped or schema-edited.
# Leave blank if that table does not exist yet.
LEADS_TABLE=leads

# ─── Sessions ───
# Generate with:  php -r "echo bin2hex(random_bytes(48));"
SESSION_SECRET=replace-me-with-96-hex-chars
SESSION_HOURS=12

# ─── n8n ───
# Called server-side only. These must never reach the browser.
N8N_WEBHOOK_URL=https://n8n.moveneticsdigital.com/webhook/lead-search
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=120

# ─── Uploads ───
# Relative paths resolve against the app root (the folder holding this file).
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=250
# Rows written per INSERT, and rows ingested per chunked-import request.
# Lower these if the host has a tight max_execution_time.
IMPORT_BATCH_SIZE=500
IMPORT_ROWS_PER_REQUEST=20000
# Rows sampled to infer column types on the confirm screen.
INFER_SAMPLE_ROWS=500
